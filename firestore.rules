rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner can only read/write their own user document and everything below it
    // (progress, vocab, stats). Everything else is denied.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
