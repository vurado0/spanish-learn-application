  {"id": "pues", "spanishLatam": "pues", "english": "well, so, then", "type": "connector", "topic": "phrases", "level": "A2", "exampleLatam": "—¿Te gusta? —Pues sí, ¡mucho!", "exampleEnglish": "—Do you like it? —Well yes, a lot!", "visual": "", "note": "Hugely common in Spain."},
  {"id": "por-eso", "spanishLatam": "por eso", "english": "that is why, so", "type": "connector", "topic": "phrases", "level": "A2", "exampleLatam": "Me encanta la historia, por eso vivo en Alcalá.", "exampleEnglish": "I love history, that is why I live in Alcalá.", "visual": ""},
  {"id": "cuando", "spanishLatam": "cuando", "english": "when", "type": "connector", "topic": "phrases", "level": "A2", "exampleLatam": "Cuando llegas a la plaza, gira a la derecha.", "exampleEnglish": "When you get to the square, turn right.", "visual": "", "note": "¿Cuándo? with accent is the question “when?”."},
