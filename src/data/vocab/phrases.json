  {"id": "tener-que", "spanishLatam": "tener que…", "english": "to have to…", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Tengo que estar allí a las diez.", "exampleEnglish": "I have to be there at ten.", "visual": "☑️"},
  {"id": "proxima-vez", "spanishLatam": "la próxima vez", "english": "next time", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "¡La próxima vez invito yo!", "exampleEnglish": "Next time it is on me!", "visual": "🔜"},
