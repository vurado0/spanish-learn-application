  {"id": "tambien", "spanishLatam": "también", "english": "also, too", "type": "connector", "topic": "phrases", "level": "A1", "exampleLatam": "—Estudio Historia. —¡Yo también!", "exampleEnglish": "—I study history. —Me too!", "visual": ""},
  {"id": "entonces", "spanishLatam": "entonces", "english": "so, then", "type": "connector", "topic": "phrases", "level": "A1", "exampleLatam": "¿Es gratis? ¡Entonces vuelvo mañana!", "exampleEnglish": "It is free? Then I am coming back tomorrow!", "visual": ""},
  {"id": "bueno", "spanishLatam": "bueno…", "english": "well…, OK", "type": "connector", "topic": "phrases", "level": "A1", "exampleLatam": "Bueno… no sé. ¿Tú qué piensas?", "exampleEnglish": "Well… I do not know. What do you think?", "visual": "", "note": "Also the adjective bueno/buena = good."},
  {"id": "ok", "spanishLatam": "está bien", "spanishSpain": "vale", "english": "OK", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "—¿Vamos al cine? —¡Está bien!", "exampleSpain": "—¿Vamos al cine? —¡Vale!", "exampleEnglish": "—Shall we go to the cinema? —OK!", "visual": "👌", "note": "You hear ¡vale! constantly in Spain. In Mexico also ¡sale! or ¡órale!"},
  {"id": "que-cool", "spanishLatam": "¡qué padre!", "spanishSpain": "¡qué guay!", "english": "how cool!", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "¡Qué padre! ¿Eres de Guadalajara?", "exampleSpain": "¡Qué guay! ¿Eres de Guadalajara?", "exampleEnglish": "How cool! You are from Guadalajara?", "visual": "🤩", "note": "¡Qué padre! is Mexican; elsewhere ¡qué chévere! or ¡qué bacán!"},
  {"id": "me-gusta", "spanishLatam": "me gusta", "english": "I like (it)", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Me gusta mucho la comida colombiana.", "exampleEnglish": "I really like Colombian food.", "visual": "❤️", "note": "Several things: me gustan los mangos."},
  {"id": "me-encanta", "spanishLatam": "me encanta", "english": "I love (it)", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Me encanta probar cosas nuevas.", "exampleEnglish": "I love trying new things.", "visual": "😍"},
  {"id": "para-mi", "spanishLatam": "para mí", "english": "for me", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Para mí, una ensalada, por favor.", "exampleEnglish": "A salad for me, please.", "visual": "🙋‍♀️"},
  {"id": "can-i-have", "spanishLatam": "¿me trae…?", "spanishSpain": "¿me pones…?", "english": "can I have…? (ordering)", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "¿Me trae un café, por favor?", "exampleSpain": "¿Me pones un café?", "exampleEnglish": "Could you bring me a coffee, please?", "visual": "🙋", "note": "Bar Spanish in Spain is direct – ¿me pones…? is not rude at all."},
  {"id": "cuanto-es", "spanishLatam": "¿cuánto es?", "english": "how much is it?", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "¿Cuánto es todo?", "exampleEnglish": "How much is everything?", "visual": "💶"},
  {"id": "cuanto-cuesta", "spanishLatam": "¿cuánto cuesta?", "english": "how much does it cost?", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "¿Cuánto cuesta el menú?", "exampleEnglish": "How much is the set menu?", "visual": "🏷️"},
  {"id": "algo-mas", "spanishLatam": "¿algo más?", "english": "anything else?", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Aquí tiene. ¿Algo más?", "exampleSpain": "Aquí tienes. ¿Algo más?", "exampleEnglish": "Here you are. Anything else?", "visual": "➕"},
  {"id": "aqui-tiene", "spanishLatam": "aquí tiene", "spanishSpain": "aquí tienes", "english": "here you are", "type": "phrase", "topic": "phrases", "level": "A1", "exampleLatam": "Aquí tiene su café.", "exampleSpain": "Aquí tienes tu café.", "exampleEnglish": "Here is your coffee.", "visual": "🫴", "note": "Tiene = usted (polite), tienes = tú. Spanish shop staff often use tú."},
