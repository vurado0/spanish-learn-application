  {"id": "ademas", "spanishLatam": "además", "english": "besides, what is more", "type": "connector", "topic": "phrases", "level": "A2", "exampleLatam": "Me gusta Alcalá. Además, la comida es muy rica.", "exampleEnglish": "I like Alcalá. Besides, the food is delicious.", "visual": ""},
