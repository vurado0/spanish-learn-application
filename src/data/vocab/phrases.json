  {"id": "pero", "spanishLatam": "pero", "english": "but", "type": "connector", "topic": "phrases", "level": "A1", "exampleLatam": "Soy de Inglaterra, pero vivo en Alcalá.", "exampleEnglish": "I am from England, but I live in Alcalá.", "visual": ""},
