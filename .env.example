# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: use the local Firebase emulators instead of a real project
# (run `npm run emulators` in another terminal; any project id starting with demo- works offline)
# VITE_USE_EMULATORS=true
